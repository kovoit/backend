# --- Django ---
DJANGO_SECRET_KEY=changer-moi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Base de données (PostgreSQL / PostGIS via docker compose) ---
DATABASE_URL=postgres://kovoit:kovoit@localhost:5432/kovoit

# --- Redis (cache + Celery) ---
CACHE_URL=rediscache://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Email (Gmail SMTP) ---
# En dev, laisser le backend console. En prod : django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=adresse@gmail.com
# Mot de passe d'application Gmail (16 caractères), JAMAIS le mot de passe du compte
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Kovoit <adresse@gmail.com>

# --- Développement sans Redis : exécuter les tâches Celery immédiatement ---
# CELERY_TASK_ALWAYS_EAGER=True
# CACHE_URL=locmemcache://

# --- Services externes ---
ROUTAGE_PROVIDER=apps.routage.providers.OsrmProvider
OSRM_URL=https://router.project-osrm.org
NOTIFICATIONS_PUSH_SENDER=apps.notifications.push.JournalPushSender
